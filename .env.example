# SSOUyuni — environment variables
# Copy to .env, fill in values, then: chmod 600 .env
# NEVER commit .env to the repository.
# Sensitive values (passwords, client secrets) are in Azure Key Vault — not here.

# ── Azure Key Vault ───────────────────────────────────────────────────────────
# Key Vault URL. VM must have System-assigned Managed Identity with Key Vault Secrets User role.
# Required secrets — shared (set once):
#   entra-client-id           App Registration client ID (multi-tenant, shared for all orgs)
#   entra-client-secret       App Registration client secret (shared for all orgs)
# Required secrets — per org (replace {org} with each org name, lowercase):
#   entra-{org}-tenant-id     Azure AD tenant GUID for org
#   uyuni-sync-{org}          password for {org}-account-sync in Uyuni
AZURE_KEYVAULT_URL=https://<keyvault-name>.vault.azure.net/

# ── Organizations ─────────────────────────────────────────────────────────────
# Comma-separated org names (lowercase). Each org must have:
#   - {org}-account-sync account in Uyuni (Organization Administrator)
#   - 2 KV secrets listed above (tenant-id + uyuni-sync)
#   - Admin consent granted in the org's Entra tenant for the shared App Registration
UYUNI_ORGS=orgA,orgB

# ── URLs ──────────────────────────────────────────────────────────────────────
# Uyuni server hostname (must match certificate CN, add to /etc/hosts if needed)
UYUNI_URL=https://uyuni-server.internal

# Public URL of this proxy — used as OIDC redirect URI and for HTML URL rewriting.
IDENTITY_SYNC_URL=https://uyuni-proxy.internal

# ── SSL ───────────────────────────────────────────────────────────────────────
# Uyuni CA certificate for SSL verification (MANDATORY)
# Service will not start without this configured correctly.
UYUNI_CA_CERT=/opt/ssouuni/ssl/uyuni-ca.crt

# ── Session ───────────────────────────────────────────────────────────────────
# Server-side session TTL in hours (default: 12)
SESSION_TTL_HOURS=12

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# ── Optional ──────────────────────────────────────────────────────────────────
# Audit log on Azure Table Storage (table: uyuniaccesslog)
# AUDIT_TABLE_CONNECTION=<storage-account-connection-string>
